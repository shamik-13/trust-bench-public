       01  WS-GL-TABLE REDEFINES WS-GL-MATRIX.
           05  WS-GL-ENTRY OCCURS 160
               ASCENDING KEY IS WS-GL-KEY
               INDEXED BY WS-GL-IDX.
               10  WS-GL-KEY             PIC X(03).
               10  WS-GL-DEBIT           PIC X(06).
               10  WS-GL-CREDIT          PIC X(06).
               10  WS-GL-COST            PIC X(05).
               10  WS-GL-CHK             PIC 9(03).

       LINKAGE SECTION.
       01  LK-KZ531S-PARM.
           05  LK-PRODUCT-TYPE-CODE      PIC X(02).
           05  LK-JRNL-TYPE              PIC X(01).
           05  LK-GP-DEBIT-ACCT-CD       PIC X(06).
           05  LK-GP-CREDIT-ACCT-CD      PIC X(06).
           05  LK-GP-COST-CENTER-CD      PIC X(05).
           05  LK-ERROR-REASON           PIC X(60).

       PROCEDURE DIVISION USING LK-KZ531S-PARM.

       MAIN-RTN.
           MOVE WS-OK TO RETURN-CODE
           MOVE SPACE TO LK-GP-DEBIT-ACCT-CD
                         LK-GP-CREDIT-ACCT-CD
                         LK-GP-COST-CENTER-CD
                         LK-ERROR-REASON

           IF LK-PRODUCT-TYPE-CODE < '01'
              OR LK-PRODUCT-TYPE-CODE > '20'
              MOVE WS-NG TO RETURN-CODE
              MOVE 'INVALID PRODUCT TYPE' TO LK-ERROR-REASON
              GOBACK
           END-IF

           PERFORM VARYING WS-WK-IDX FROM 1 BY 1
             UNTIL WS-WK-IDX > 8
                OR LK-JRNL-TYPE = WS-JRNL-CD(WS-WK-IDX)
              CONTINUE
           END-PERFORM

           IF WS-WK-IDX > 8
              MOVE WS-NG TO RETURN-CODE
              MOVE 'INVALID JOURNAL TYPE' TO LK-ERROR-REASON
              GOBACK
           END-IF

           STRING LK-PRODUCT-TYPE-CODE DELIMITED BY SIZE
                  LK-JRNL-TYPE         DELIMITED BY SIZE
             INTO WS-SEARCH-KEY
           END-STRING

           PERFORM SEARCH-GL-MATRIX

           IF WS-FOUND NOT = 'Y'
              MOVE WS-NG TO RETURN-CODE
              MOVE 'GL CODE NOT REGISTERED' TO LK-ERROR-REASON
              GOBACK
           END-IF

           MOVE WS-GL-DEBIT(WS-MID)  TO LK-GP-DEBIT-ACCT-CD
           MOVE WS-GL-CREDIT(WS-MID) TO LK-GP-CREDIT-ACCT-CD
           MOVE WS-GL-COST(WS-MID)   TO LK-GP-COST-CENTER-CD

           PERFORM VALIDATE-CHECKSUM

           IF WS-DIGIT-SUM NOT = WS-GL-CHK(WS-MID)
              MOVE WS-NG TO RETURN-CODE
              MOVE 'ACCOUNT COMBINATION CHECK ERROR' TO LK-ERROR-REASON
              MOVE SPACE TO LK-GP-DEBIT-ACCT-CD
                            LK-GP-CREDIT-ACCT-CD
                            LK-GP-COST-CENTER-CD
              GOBACK
           END-IF

           MOVE WS-OK TO RETURN-CODE
           GOBACK.

       SEARCH-GL-MATRIX.
           MOVE 1 TO WS-LOW
           MOVE WS-MAX-ENTRY TO WS-HIGH
           MOVE 'N' TO WS-FOUND

           PERFORM UNTIL WS-LOW > WS-HIGH OR WS-FOUND = 'Y'
              COMPUTE WS-MID = (WS-LOW + WS-HIGH) / 2
              EVALUATE TRUE
                 WHEN WS-SEARCH-KEY = WS-GL-KEY(WS-MID)
                    MOVE 'Y' TO WS-FOUND
                 WHEN WS-SEARCH-KEY < WS-GL-KEY(WS-MID)
                    COMPUTE WS-HIGH = WS-MID - 1
                 WHEN OTHER
                    COMPUTE WS-LOW = WS-MID + 1
              END-EVALUATE
           END-PERFORM.

       VALIDATE-CHECKSUM.
           MOVE ZERO TO WS-DIGIT-SUM

           MOVE LK-GP-DEBIT-ACCT-CD TO WS-WK-ACCT
           PERFORM ADD-ACCOUNT-DIGITS

           MOVE LK-GP-CREDIT-ACCT-CD TO WS-WK-ACCT
           PERFORM ADD-ACCOUNT-DIGITS.

       ADD-ACCOUNT-DIGITS.
           PERFORM VARYING WS-WK-IDX FROM 1 BY 1
             UNTIL WS-WK-IDX > 6
              IF WS-WK-ACCT(WS-WK-IDX:1) IS NUMERIC
                 MOVE WS-WK-ACCT(WS-WK-IDX:1) TO WS-WK-DIGIT
                 ADD WS-WK-DIGIT TO WS-DIGIT-SUM
              ELSE
                 MOVE 999 TO WS-DIGIT-SUM
                 MOVE 7 TO WS-WK-IDX
              END-IF
           END-PERFORM.
