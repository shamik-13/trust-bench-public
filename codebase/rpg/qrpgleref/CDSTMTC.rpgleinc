       // CDSTMTC -- CDSTMTF レコードレイアウト (record layout). Shared/pinned.
       dcl-ds cdstmtf_rec qualified;
         mt_statement_id    char(10);
         mt_member_id       char(10);
         mt_card_no         char(16);
         mt_sale_id         char(10);
         mt_billed_amt      packed(13:2);
         mt_fee_amt         packed(13:2);
         mt_posting_dt      packed(8:0);
       end-ds;
