       // CDSTMFC -- CDSTMF レコードレイアウト (record layout). Shared/pinned.
       dcl-ds cdstmf_rec qualified;
         st_card_no         char(16);
         st_statement_id    char(10);
         st_txn_id          char(10);
         st_line_kbn        char(2);
         st_line_amt        packed(13:2);
         st_line_label      char(10);
       end-ds;
